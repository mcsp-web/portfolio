# ── Set automatically by the provisioner ──────────────────────────────────
APP_NAME=
APP_ENV=production
APP_KEY=                     # generated (base64:...)
APP_DEBUG=false
APP_URL=                     # https://<domain>

LOG_CHANNEL=stderr           # serversideup logs → Coolify log viewer

DB_CONNECTION=pgsql
DB_HOST=                     # internal Coolify Postgres host
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=                 # generated

# ── App defaults (adjust per template as needed) ──────────────────────────
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── File storage (MinIO / S3) — set automatically when --minio is used ────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=                # http://<slug>-minio:9000  (internal)
AWS_URL=                     # https://s3-<slug>.<host_domain> (public)
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Mail (Resend) — MAIL_MAILER set automatically; KEY is MANUAL ──────────
MAIL_MAILER=resend
RESEND_API_KEY=              # ← paste in Coolify after provisioning
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Maps (optional) — MANUAL ──────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Payments (optional, Haiti) — MANUAL ───────────────────────────────────
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox

# ── Portfolio — admin screenshot uploads ──────────────────────────────────
# "public" = the app's storage volume; "s3" = the MinIO bucket above.
PORTFOLIO_UPLOAD_DISK=public
